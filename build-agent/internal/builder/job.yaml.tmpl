# k8s Job template for one build. Rendered with builder.JobParams via text/template.
# Per-build ephemeral namespace, no-perms SA, gVisor sandbox, default-deny netpol.
# The builder container clones the repo, detects Dockerfile vs nixpacks, then runs
# `buildctl` against the rootless buildkitd sidecar, pushing the result to Harbor.
apiVersion: batch/v1
kind: Job
metadata:
  name: build-{{ .BuildID }}
  namespace: {{ .Namespace }}
  labels:
    dada.io/build: "{{ .BuildID }}"
spec:
  backoffLimit: 0
  activeDeadlineSeconds: {{ .TimeoutSeconds }}
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        dada.io/build: "{{ .BuildID }}"
    spec:
      restartPolicy: Never
      {{- if .RuntimeClass }}
      runtimeClassName: {{ .RuntimeClass }}
      {{- end }}
      automountServiceAccountToken: false
      serviceAccountName: build-runner-noperms
      {{- if .NodePoolLabel }}
      nodeSelector:
        {{ .NodePoolLabel }}: build
      tolerations:
        - key: {{ .NodePoolLabel }}
          operator: Equal
          value: build
          effect: NoSchedule
      {{- end }}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        fsGroup: 1000
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: builder
          image: {{ .BuilderImage }}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          env:
            - name: GIT_URL
              value: "{{ .GitURL }}"
            - name: GIT_BRANCH
              value: "{{ .GitBranch }}"
            - name: GIT_SHA
              value: "{{ .GitSHA }}"
            - name: ROOT_DIR
              value: "{{ .RootDir }}"
            - name: FRAMEWORK
              value: "{{ .Framework }}"
            - name: IMAGE_NAME
              value: "{{ .ImageName }}"
            - name: IMAGE_TAG
              value: "{{ .ImageTag }}"
            - name: CACHE_REF
              value: "{{ .CacheRef }}"
            - name: BUILDKIT_HOST
              value: "unix:///run/buildkit/buildkitd.sock"
            - name: DOCKER_CONFIG
              value: "/secrets/registry"
          command: ["/bin/sh", "-c"]
          args:
            - |
              set -eu
              echo "==> cloning {{ .GitURL }} ({{ .GitBranch }})"
              {{- if .GitSecretName }}
              GIT_ASKPASS=/secrets/git/askpass.sh
              export GIT_ASKPASS
              {{- end }}
              git clone --depth 1 --branch "$GIT_BRANCH" "$GIT_URL" /workspace/src
              cd /workspace/src
              git checkout "$GIT_SHA" 2>/dev/null || true
              CTX="/workspace/src/$ROOT_DIR"
              DOCKERFILE_DIR="$CTX"
              if [ -f "$CTX/Dockerfile" ] && [ "$FRAMEWORK" != "nixpacks" ]; then
                echo "==> Dockerfile detected"
              else
                echo "==> nixpacks build (zero-config)"
                nixpacks build "$CTX" --out /workspace/nixpacks
                DOCKERFILE_DIR="/workspace/nixpacks/.nixpacks"
              fi
              echo "==> waiting for buildkitd"
              for i in $(seq 1 60); do
                buildctl debug workers >/dev/null 2>&1 && break
                sleep 1
              done
              echo "==> building + pushing $IMAGE_NAME"
              buildctl build \
                --frontend dockerfile.v0 \
                --local context="$CTX" \
                --local dockerfile="$DOCKERFILE_DIR" \
                --output type=image,\"name=$IMAGE_NAME,$IMAGE_TAG\",push=true \
                --export-cache type=registry,ref="$CACHE_REF",mode=max \
                --import-cache type=registry,ref="$CACHE_REF" \
                {{- if .BuildEnvSecretName }}
                $(for f in /secrets/buildenv/*; do [ -f "$f" ] && echo "--secret id=$(basename "$f"),src=$f"; done) \
                {{- end }}
                --metadata-file /workspace/metadata.json
              echo "==> digest:$(cat /workspace/metadata.json | sed -n 's/.*\"containerimage.digest\":\"\(sha256:[a-f0-9]*\)\".*/\1/p')"
          resources:
            limits:
              cpu: "{{ .CPULimit }}"
              memory: "{{ .MemLimit }}"
          volumeMounts:
            - name: workspace
              mountPath: /workspace
            - name: buildkit-sock
              mountPath: /run/buildkit
            {{- if .GitSecretName }}
            - name: git-creds
              mountPath: /secrets/git
              readOnly: true
            {{- end }}
            {{- if .RegistrySecretName }}
            - name: registry-creds
              mountPath: /secrets/registry
              readOnly: true
            {{- end }}
            {{- if .BuildEnvSecretName }}
            - name: build-env
              mountPath: /secrets/buildenv
              readOnly: true
            {{- end }}
        - name: buildkitd
          image: moby/buildkit:rootless
          args:
            - --addr
            - unix:///run/buildkit/buildkitd.sock
            - --oci-worker-no-process-sandbox
          securityContext:
            seccompProfile:
              type: Unconfined # required by buildkitd; gVisor + node pool contain it
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
          resources:
            limits:
              cpu: "{{ .CPULimit }}"
              memory: "{{ .MemLimit }}"
          volumeMounts:
            - name: buildkit-sock
              mountPath: /run/buildkit
            - name: workspace
              mountPath: /workspace
      volumes:
        - name: workspace
          emptyDir:
            sizeLimit: 8Gi
        - name: buildkit-sock
          emptyDir: {}
        {{- if .GitSecretName }}
        - name: git-creds
          secret:
            secretName: {{ .GitSecretName }}
            defaultMode: 0500
        {{- end }}
        {{- if .RegistrySecretName }}
        - name: registry-creds
          secret:
            secretName: {{ .RegistrySecretName }}
            items:
              - key: .dockerconfigjson
                path: config.json
        {{- end }}
        {{- if .BuildEnvSecretName }}
        - name: build-env
          secret:
            secretName: {{ .BuildEnvSecretName }}
        {{- end }}
