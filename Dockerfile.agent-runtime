# Build from repository root: docker build -f Dockerfile.agent-runtime backend
FROM golang:1.25-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o agent-runtime ./cmd/agent-runtime

FROM alpine:3.22
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /build/agent-runtime .
EXPOSE 8083
CMD ["./agent-runtime"]
