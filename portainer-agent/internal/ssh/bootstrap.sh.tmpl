#!/usr/bin/env bash
# Rendered by portainer-agent Go text/template, piped via SSH stdin.
# Template vars: .ServerName .EdgeKey .EdgeID
#                .PrometheusRemoteWriteURL .PrometheusUser .PrometheusPass
#                .ElasticsearchURL .ElasticsearchAPIKey
# Observability sidecars (prometheus-agent, filebeat) render only when their
# endpoint URL is non-empty AND public; see RenderBootstrap / the set +e block.
set -euo pipefail

echo "[bootstrap] Starting VM setup for {{.ServerName}}"

# ── Docker ───────────────────────────────────────────────────────────────────
# Idempotent: only install if Docker is absent. On pre-provisioned VMs that
# already run docker-ce, `apt-get install docker.io` aborts with a package
# conflict ("pkgProblemResolver generated breaks"), which previously killed the
# whole bootstrap (set -e) before the edge agent could deploy.
if command -v docker >/dev/null 2>&1; then
  echo "[bootstrap] Docker already present ($(docker --version 2>/dev/null)) — skipping install"
else
  apt-get update -qq
  apt-get install -y -qq docker.io docker-compose-plugin curl wget
fi
systemctl enable docker --now 2>/dev/null || true
echo "[bootstrap] Docker ready"

# Observability stack below is best-effort: on pre-provisioned VMs a port clash
# (e.g. :8080 already taken) or a download hiccup must NOT prevent the Portainer
# Edge Agent (the thing that makes the AppServer reach Ready) from deploying.
set +e

# Observability sidecars are OPT-IN and emitted only when a PUBLIC, externally
# resolvable monitoring endpoint is configured. RenderBootstrap blanks any
# in-cluster (…svc.cluster.local) URL before rendering, because external
# manual-connect VMs cannot resolve cluster DNS — pointing prometheus-agent /
# filebeat at such hosts makes them crash-loop (same root-cause class as the
# edge-endpoint in-cluster-URL bug fixed in commit c39d3b7). An empty URL here
# means "skip this sidecar" rather than "deploy with an unreachable target".
{{if .PrometheusRemoteWriteURL}}
# ── Free-port selection ──────────────────────────────────────────────────────
# VMs differ — common ports (9100, 8080) may already be taken by the workload.
# Pick the first FREE port from a list of uncommon candidates and feed the SAME
# value into both the exporter and Prometheus' scrape target, so the agent always
# knows where to scrape. Avoids the "port already allocated" crash seen on loaded
# VMs (e.g. :8080 used by an existing app).
pick_port() {
  for _p in "$@"; do
    if command -v ss >/dev/null 2>&1; then
      ss -ltn 2>/dev/null | grep -q ":${_p} " || { echo "$_p"; return; }
    else
      (exec 3<>/dev/tcp/127.0.0.1/${_p}) 2>/dev/null && exec 3>&- || { echo "$_p"; return; }
    fi
  done
  echo "$1"
}
NODE_EXPORTER_PORT=$(pick_port 19100 39100 49100 9100)
CADVISOR_PORT=$(pick_port 18080 38080 48080 8080)
echo "[bootstrap] observability ports: node_exporter=${NODE_EXPORTER_PORT} cadvisor=${CADVISOR_PORT}"

# ── node_exporter 1.8.2 ──────────────────────────────────────────────────────
useradd --no-create-home --shell /bin/false node_exporter 2>/dev/null || true
NODE_VER="1.8.2"
wget -q "https://github.com/prometheus/node_exporter/releases/download/v${NODE_VER}/node_exporter-${NODE_VER}.linux-amd64.tar.gz" -O /tmp/ne.tar.gz
tar -xzf /tmp/ne.tar.gz -C /tmp
mv "/tmp/node_exporter-${NODE_VER}.linux-amd64/node_exporter" /usr/local/bin/
chown node_exporter:node_exporter /usr/local/bin/node_exporter
rm -rf /tmp/ne.tar.gz "/tmp/node_exporter-${NODE_VER}.linux-amd64"

cat > /etc/systemd/system/node_exporter.service << UNIT
[Unit]
Description=Prometheus Node Exporter
After=network.target
[Service]
User=node_exporter
ExecStart=/usr/local/bin/node_exporter --collector.systemd --collector.processes --web.listen-address=:${NODE_EXPORTER_PORT}
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload && systemctl enable node_exporter 2>/dev/null
# restart (not just enable --now) so a previously-running instance picks up the
# new --web.listen-address port.
systemctl restart node_exporter
echo "[bootstrap] node_exporter :${NODE_EXPORTER_PORT} started"

# ── cAdvisor v0.49.1 ─────────────────────────────────────────────────────────
# cAdvisor has many bind mounts and is slow to remove; wait for the name to free
# before recreating, else "name already in use / Removal In Progress".
docker rm -f cadvisor 2>/dev/null || true
_i=0; while docker inspect cadvisor >/dev/null 2>&1 && [ $_i -lt 45 ]; do sleep 2; _i=$((_i+1)); done
docker run -d \
  --name cadvisor --restart unless-stopped \
  -v /:/rootfs:ro -v /var/run:/var/run:ro \
  -v /sys:/sys:ro -v /var/lib/docker/:/var/lib/docker:ro \
  -p ${CADVISOR_PORT}:8080 gcr.io/cadvisor/cadvisor:v0.49.1
echo "[bootstrap] cAdvisor :${CADVISOR_PORT} started"

# ── Prometheus Agent → remote_write ──────────────────────────────────────────
mkdir -p /etc/prometheus-agent /var/lib/prometheus-agent
cat > /etc/prometheus-agent/prometheus.yml << PROMEOF
global:
  scrape_interval: 30s
  external_labels:
    vm_name: "{{.ServerName}}"
    runtime: "vm"
scrape_configs:
  - job_name: node_exporter
    static_configs:
      - targets: ["localhost:${NODE_EXPORTER_PORT}"]
  - job_name: cadvisor
    static_configs:
      - targets: ["localhost:${CADVISOR_PORT}"]
    metric_relabel_configs:
      - source_labels: [container_label_dada_io_app]
        target_label: app
remote_write:
  - url: "{{.PrometheusRemoteWriteURL}}"
    basic_auth:
      username: "{{.PrometheusUser}}"
      password: "{{.PrometheusPass}}"
PROMEOF

docker rm -f prometheus-agent 2>/dev/null || true
# prom/prometheus runs as uid 65534 (nobody); the host data dir is root-owned
# after mkdir, so the agent cannot take its storage lock. Fix ownership first.
chown -R 65534:65534 /var/lib/prometheus-agent 2>/dev/null || true
docker run -d \
  --name prometheus-agent --restart unless-stopped \
  -v /etc/prometheus-agent/prometheus.yml:/etc/prometheus/prometheus.yml:ro \
  -v /var/lib/prometheus-agent:/prometheus \
  --network host \
  prom/prometheus:v2.53.0 \
  --config.file=/etc/prometheus/prometheus.yml \
  --enable-feature=agent \
  --storage.agent.path=/prometheus
echo "[bootstrap] Prometheus Agent started (remote_write to {{.PrometheusRemoteWriteURL}})"
{{else}}
echo "[bootstrap] No public Prometheus remote_write endpoint configured — skipping node_exporter/cAdvisor/prometheus-agent"
{{end}}
{{if .ElasticsearchURL}}
# ── Filebeat 8.13.4 → Elasticsearch ─────────────────────────────────────────
mkdir -p /etc/filebeat
cat > /etc/filebeat/filebeat.yml << FBEOF
filebeat.inputs:
  - type: container
    paths:
      - /var/lib/docker/containers/*/*.log
    stream: all
    processors:
      - add_docker_metadata:
          host: "unix:///var/run/docker.sock"
      - drop_fields:
          fields: ["agent", "ecs"]
          ignore_missing: true
output.elasticsearch:
  hosts: ["{{.ElasticsearchURL}}"]
  api_key: "{{.ElasticsearchAPIKey}}"
  index: "dada-vm-logs-%{[container.labels.dada_io_app]:unknown}-%{+yyyy.MM.dd}"
setup.ilm.enabled: false
setup.template.enabled: false
logging.level: warning
FBEOF

docker rm -f filebeat 2>/dev/null || true
docker run -d \
  --name filebeat --restart unless-stopped --user root \
  -v /etc/filebeat/filebeat.yml:/usr/share/filebeat/filebeat.yml:ro \
  -v /var/lib/docker/containers:/var/lib/docker/containers:ro \
  -v /var/run/docker.sock:/var/run/docker.sock:ro \
  docker.elastic.co/beats/filebeat:8.13.4
echo "[bootstrap] Filebeat started"
{{else}}
echo "[bootstrap] No public Elasticsearch endpoint configured — skipping filebeat"
{{end}}

# ── Portainer Edge Agent 2.21.0 ──────────────────────────────────────────────
# Critical path: restore strict mode and ensure a clean (re)deploy.
set -e
docker rm -f portainer_edge_agent 2>/dev/null || true
docker run -d \
  --name portainer_edge_agent --restart=always \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /var/lib/docker/volumes:/var/lib/docker/volumes \
  -v /:/host -v portainer_agent_data:/data \
  -e EDGE=1 \
  -e EDGE_ID="{{.EdgeID}}" \
  -e EDGE_KEY="{{.EdgeKey}}" \
  -e EDGE_INSECURE_POLL=0 \
  portainer/agent:2.21.0
echo "[bootstrap] Portainer Edge Agent started (EDGE_ID={{.EdgeID}})"

echo "BOOTSTRAP_COMPLETE"
