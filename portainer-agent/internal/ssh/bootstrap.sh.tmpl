#!/usr/bin/env bash
# Rendered by portainer-agent Go text/template, piped via SSH stdin.
# Template vars: .ServerName .EdgeKey .EdgeID .PromTenant
#                .PrometheusRemoteWriteURL .PrometheusUser .PrometheusPass
#                .ElasticsearchURL .ElasticsearchAPIKey
# Observability sidecars (prometheus-agent, filebeat) render only when their
# endpoint URL is non-empty AND public; see RenderBootstrap / the set +e block.
set -euo pipefail

echo "[bootstrap] Starting VM setup for {{.ServerName}}"

# ── Docker ───────────────────────────────────────────────────────────────────
# Idempotent: only install if Docker is absent. On pre-provisioned VMs that
# already run docker-ce, `apt-get install docker.io` aborts with a package
# conflict ("pkgProblemResolver generated breaks"), which previously killed the
# whole bootstrap (set -e) before the edge agent could deploy.
if command -v docker >/dev/null 2>&1; then
  echo "[bootstrap] Docker already present ($(docker --version 2>/dev/null)) — skipping install"
else
  for i in $(seq 1 60); do
    if fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1; then
      echo "[bootstrap] waiting for apt lock (cloud-init/unattended-upgrades), attempt $i"
      sleep 10
    else
      break
    fi
  done
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq docker.io docker-compose-v2 curl wget
fi
systemctl enable docker --now 2>/dev/null || true
echo "[bootstrap] Docker ready"

# ── Per-VM identity for the fleet edge stack ─────────────────────────────────
# The fleet observability edge stack (one compose for the whole dada-vms group)
# reads VM_NAME from here to label metrics / name the log index per VM. Written
# once at enroll; the group-wide config is delivered/updated via the edge stack,
# not by re-running this bootstrap. See tasks/vm-fleet-config-plan.md.
mkdir -p /etc/dada
cat > /etc/dada/vm.env <<VMENV
VM_NAME={{.ServerName}}
{{if .PrometheusRemoteWriteURL}}PROM_REMOTE_WRITE_URL={{.PrometheusRemoteWriteURL}}
PROM_USER={{.PrometheusUser}}
PROM_PASS={{.PrometheusPass}}
PROM_TENANT={{.PromTenant}}
{{end}}VMENV
chmod 600 /etc/dada/vm.env
echo "[bootstrap] wrote /etc/dada/vm.env (VM_NAME={{.ServerName}}, fleet edge-stack identity)"

# ── Observability: delivered by the fleet edge stack, NOT bootstrap ──────────
# node_exporter, cadvisor, prometheus-agent (metrics) AND fluent-bit (logs) all
# live in the `vm-observability` Portainer edge stack on the dada-vms group,
# reconciled from git onto the whole fleet. That means one git edit updates every
# VM's node config — no per-VM SSH / bootstrap re-run. Bootstrap's only job is to
# drop the edge agent + the per-VM identity file (/etc/dada/vm.env above); the
# joinFleet worker step then tags the endpoint into the group and ensures the edge
# stack. See tasks/vm-fleet-config-plan.md.

# ── Logs: delivered by the fleet edge stack, NOT bootstrap ───────────────────
# filebeat is gone: filebeat 8.x is incompatible with OpenSearch (Elastic
# `_license` handshake → 400), which broke VM logs fleet-wide after the
# ES→OpenSearch migration. Container-log shipping is now a fluent-bit service in
# the `vm-observability` Portainer edge stack (dada-vms group), reconciled from
# git onto every VM — so the shipper is updated fleet-wide by editing the edge
# stack, never by re-running this bootstrap. joinFleet (worker) tags the endpoint
# into the group + ensures the edge stack right after enrollment.

# ── Portainer Edge Agent 2.21.0 ──────────────────────────────────────────────
# Critical path: restore strict mode and ensure a clean (re)deploy.
set -e
docker rm -f portainer_edge_agent 2>/dev/null || true
docker run -d \
  --name portainer_edge_agent --restart=always \
  --log-driver none \
  -v /var/run/docker.sock:/var/run/docker.sock \
  -v /var/lib/docker/volumes:/var/lib/docker/volumes \
  -v /:/host -v portainer_agent_data:/data \
  -e EDGE=1 \
  -e EDGE_ID="{{.EdgeID}}" \
  -e EDGE_KEY="{{.EdgeKey}}" \
  -e EDGE_INSECURE_POLL=0 \
  portainer/agent:2.21.0
echo "[bootstrap] Portainer Edge Agent started (EDGE_ID={{.EdgeID}})"

echo "BOOTSTRAP_COMPLETE"
