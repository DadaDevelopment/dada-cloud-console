# @dada/* packages (e.g. @dada/react-sso) come from the internal Nexus npm repo.
# Public deps still resolve from the default registry (registry.npmjs.org).
@dada:registry=https://nexus.dada-tuda.ru/repository/npm/

# Auth is NOT stored here. npm expands ${NEXUS_NPM_AUTH} from the environment:
#   base64("<nexus-user>:<nexus-pass>")
# Local dev:  export NEXUS_NPM_AUTH=$(printf '%s:%s' user pass | base64)
# CI (Jenkins): injected from the 'docker-nexus-admin-psws' credential.
//nexus.dada-tuda.ru/repository/npm/:_auth=${NEXUS_NPM_AUTH}

fund=false
audit=false
